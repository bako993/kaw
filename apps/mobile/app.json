{
  "expo": {
    "name": "Kaw",
    "slug": "kaw",
    "owner": "bako.devsolutions",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "kaw",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bakodevsolutions.kaw",
      "supportsTablet": true,
      "requireFullScreen": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bakodevsolutions.kaw",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Vazirmatn-Medium.ttf",
            "./assets/fonts/Vazirmatn-ExtraBold.ttf",
            "./assets/fonts/Nunito-SemiBold.ttf",
            "./assets/fonts/Nunito-ExtraBold.ttf"
          ]
        }
      ],
      "./plugins/with-android-build-limits.js",
      "./plugins/with-android-no-rtl.js",
      "./plugins/with-android-sideways.js",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ba3c6d95-7b81-4bfd-84cb-d250bad942ce"
      }
    }
  }
}
